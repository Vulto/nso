+ 	 oblt->p_glUseProgramObjectARB(CSP[0].p);
+	 for(unsigned i = 0; i < 12; i++)
+	  oblt->p_glUniform1fARB(oblt->p_glGetUniformLocationARB(CSP[0].p, pn[i]), NsoCrtP[i]);
+	 oblt->p_glUniform1fARB(oblt->p_glGetUniformLocationARB(CSP[0].p, "angleSet"), NsoCrtP[12]);
+	 oblt->p_glUniform1fARB(oblt->p_glGetUniformLocationARB(CSP[0].p, "CrtFast"), NsoCrtFast);
