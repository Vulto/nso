+void OpenGL_Blitter_Shader::NsoCrtEnsure(int w, int h)
+{
+#ifdef __linux__
+	if(w < 1) w = 1;
+	if(h < 1) h = 1;
+	if(!NsoCrtGL[0]) {
+		NsoCrtGL[0] = NsoCrtProc("glGenFramebuffers");
+		NsoCrtGL[1] = NsoCrtProc("glBindFramebuffer");
+		NsoCrtGL[2] = NsoCrtProc("glFramebufferTexture2D");
+		NsoCrtGL[3] = NsoCrtProc("glDeleteFramebuffers");
+		NsoCrtGL[4] = NsoCrtProc("glGenTextures");
+		NsoCrtGL[5] = NsoCrtProc("glDeleteTextures");
+		NsoCrtGL[6] = NsoCrtProc("glCheckFramebufferStatus");
+		NsoCrtGL[7] = NsoCrtProc("glBlitFramebuffer");
+		if(!NsoCrtGL[7]) NsoCrtGL[7] = NsoCrtProc("glBlitFramebufferEXT");
+		NsoCrtGL[8] = NsoCrtProc("glDrawBuffer");
+	}
+	if(!NsoCrtGL[0] || !NsoCrtGL[1] || !NsoCrtGL[2]) return;
+	typedef void (*GenFB)(GLsizei, GLuint *);
+	typedef void (*BindFB)(GLenum, GLuint);
+	typedef void (*FBTex)(GLenum, GLenum, GLenum, GLuint, GLint);
+	typedef void (*DelFB)(GLsizei, const GLuint *);
+	if(NsoCrtFbo && (NsoCrtIw != w || NsoCrtIh != h)) {
+		if(NsoCrtGL[3]) ((DelFB)NsoCrtGL[3])(1, &NsoCrtFbo);
+		if(NsoCrtColor) oblt->p_glDeleteTextures(1, &NsoCrtColor);
+		NsoCrtFbo = NsoCrtColor = 0;
+	}
+	if(!NsoCrtFbo) {
+		oblt->p_glGenTextures(1, &NsoCrtColor);
+		oblt->p_glBindTexture(GL_TEXTURE_2D, NsoCrtColor);
+		oblt->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		oblt->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		oblt->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		oblt->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		oblt->p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+		((GenFB)NsoCrtGL[0])(1, &NsoCrtFbo);
+		((BindFB)NsoCrtGL[1])(GL_FRAMEBUFFER, NsoCrtFbo);
+		((FBTex)NsoCrtGL[2])(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, NsoCrtColor, 0);
+		GLenum ok = GL_FRAMEBUFFER_COMPLETE;
+		if (NsoCrtGL[6]) {
+		 typedef GLenum (*ChkFB)(GLenum);
+		 ok = ((ChkFB)NsoCrtGL[6])(GL_FRAMEBUFFER);
+		}
+		((BindFB)NsoCrtGL[1])(GL_FRAMEBUFFER, 0);
+		if (ok != GL_FRAMEBUFFER_COMPLETE) {
+		 if(NsoCrtGL[3]) { typedef void (*DelFB)(GLsizei, const GLuint *); ((DelFB)NsoCrtGL[3])(1, &NsoCrtFbo); }
+		 if(NsoCrtColor) oblt->p_glDeleteTextures(1, &NsoCrtColor);
+		 NsoCrtFbo = NsoCrtColor = 0;
+		 NsoCrtIw = NsoCrtIh = 0;
+		 return;
+		}
+		NsoCrtIw = w;
+		NsoCrtIh = h;
+	}
+	if(!NsoCrtBlitP) {
+		static const char vs[] = "void main(void){ gl_Position = ftransform(); gl_TexCoord[0] = gl_MultiTexCoord0; }";
+		static const char fs[] =
+			"uniform sampler2D Tex0;\n"
+			"uniform float DotMask;\n"
+			"void main(void){\n"
+			" vec3 c = texture2D(Tex0, gl_TexCoord[0].xy).rgb;\n"
+			" if(DotMask > 0.5){\n"
+			"  vec3 m = mix(vec3(1.0, 0.7, 1.0), vec3(0.7, 1.0, 0.7), floor(mod(gl_FragCoord.x, 2.0)));\n"
+			"  c *= m * 1.05;\n"
+			" }\n"
+			" gl_FragColor = vec4(c, 1.0);\n"
+			"}\n";
+		CompiledShader cs = {};
+		try { CompileShader(cs, vs, fs); NsoCrtBlitP = (GLuint)cs.p; }
+		catch(...) { NsoCrtBlitP = 0; }
+	}
+#else
+	(void)w; (void)h;
+#endif
+}
