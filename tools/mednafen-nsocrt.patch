+	  oblt->p_glOrtho(dest_rect->x, dest_rect->x + dw, dest_rect->y + dh, dest_rect->y, -1.0, 1.0);
+	 }
+#endif
+	 /* Ensure and the FBO path bind our target texture; the caller then
