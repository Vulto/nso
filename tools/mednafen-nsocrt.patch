+		if(NsoCrtScissor) oblt->p_glDisable(GL_SCISSOR_TEST);
+		bool presented = false;
+		if(NsoCrtBlitP) {
+		 oblt->p_glUseProgramObjectARB((GLhandleARB)NsoCrtBlitP);
+		 oblt->p_glBindTexture(GL_TEXTURE_2D, NsoCrtColor);
+		 GLint loc = oblt->p_glGetUniformLocationARB((GLhandleARB)NsoCrtBlitP, "Tex0");
+		 if(loc >= 0) oblt->p_glUniform1iARB(loc, 0);
+		 oblt->p_glUniform1fARB(oblt->p_glGetUniformLocationARB((GLhandleARB)NsoCrtBlitP, "DotMask"), 1.0f);
+		 oblt->p_glBegin(GL_QUADS);
+		 oblt->p_glTexCoord2f(0.0f, 1.0f); oblt->p_glVertex2f((float)dx, (float)dy);
+		 oblt->p_glTexCoord2f(1.0f, 1.0f); oblt->p_glVertex2f((float)(dx + dw), (float)dy);
+		 oblt->p_glTexCoord2f(1.0f, 0.0f); oblt->p_glVertex2f((float)(dx + dw), (float)(dy + dh));
+		 oblt->p_glTexCoord2f(0.0f, 0.0f); oblt->p_glVertex2f((float)dx, (float)(dy + dh));
+		 oblt->p_glEnd();
+		 presented = true;
+		}
+		if(!presented && NsoCrtGL[7]) {
+		 typedef void (*BlitFB)(GLint,GLint,GLint,GLint,GLint,GLint,GLint,GLint,GLbitfield,GLenum);
