+		 ((BindFB)NsoCrtGL[1])(0x8CA9, 0);
+		 if(NsoCrtGL[8]) ((DrawBuf)NsoCrtGL[8])(0x0405);
+		 ((BlitFB)NsoCrtGL[7])(0, 0, NsoCrtIw, NsoCrtIh, dx, gy0, dx + dw, gy1, 0x00004000, 0x2601);
+		 ((BindFB)NsoCrtGL[1])(GL_FRAMEBUFFER, 0);
+		}
