@@ -582,6 +807,49 @@ void OpenGL_Blitter_Shader::ShaderBegin(const int gl_screen_w, const int gl_scre
 
 void OpenGL_Blitter_Shader::ShaderEnd(void)
 {
+#ifdef __linux__
+	if(OurType == SHADER_NSOCRT && NsoCrtFbo && NsoCrtGL[1]) {
+		typedef void (*BindFB)(GLenum, GLuint);
+		typedef void (*DrawBuf)(GLenum);
+		oblt->p_glMatrixMode(GL_MODELVIEW);
+		oblt->p_glPopMatrix();
+		int dx = NsoCrtDest[0], dy = NsoCrtDest[1], dw = NsoCrtDest[2], dh = NsoCrtDest[3];
+		/* Present the low-res CRT FBO with the 2-px mask at final resolution.
+		 * Prefer the textured blit (the mask lives there). Restore GL_BACK
+		 * before drawing: ShaderBegin set COLOR_ATTACHMENT0 on the FBO. */
+		((BindFB)NsoCrtGL[1])(GL_FRAMEBUFFER, 0);
+		if(NsoCrtGL[8]) ((DrawBuf)NsoCrtGL[8])(0x0405); /* GL_BACK */
