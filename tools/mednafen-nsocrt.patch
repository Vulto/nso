+void OpenGL_Blitter_Shader::NsoCrtPollParams(void)
+{
+ struct stat st;
+ if(NsoCrtParamsPath.empty() || stat(NsoCrtParamsPath.c_str(), &st))
+  return;
+ const long long stamp = (long long)st.st_mtim.tv_sec * 1000000000LL + st.st_mtim.tv_nsec + (long long)st.st_size;
+ if(stamp == NsoCrtParamsStamp)
+  return;
+ FILE *fp = fopen(NsoCrtParamsPath.c_str(), "r");
+ if(!fp)
+  return;
+ float v[14];
+ unsigned n = 0;
+ while(n < 14 && fscanf(fp, "%f", &v[n]) == 1)
+  n++;
+ fclose(fp);
+ if(n < 13)
+  return;
+ for(unsigned i = 0; i < 13; i++)
+  NsoCrtP[i] = v[i];
+ if(n >= 14)
+  NsoCrtFast = v[13] > 0.5f ? 1.0f : 0.0f;
+ NsoCrtParamsStamp = stamp;
+}
